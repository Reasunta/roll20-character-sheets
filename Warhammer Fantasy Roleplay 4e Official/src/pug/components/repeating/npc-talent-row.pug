mixin npc-talent-row
    input(name=`attr_talent_settings`, type="hidden", value=1)
    .wfrp-npctalent__row

        .wfrp-npctalent__cell--settingstoggle
            +display-toggle(`talent_settings`, true)

        .wfrp-npctalent__cell--title
            button(type="roll", value=rolls.npctalent)
                span(name=`attr_talent_name`)
                span(name=`attr_talent_enabled_display`)
                span.wfrp-npctalent__ranks(name=`attr_talent_ranks`)

        .wfrp-npctalent__cell--description
            span(name=`attr_talent_description`)
            
        .wfrp-settings.control__hide--npctalent_settings
            +talent-row-settings()