mixin hand-header(hand)
    div.sheet-grid-6.sheet-grid-gap-5.sheet-grid-align-content-center.sheet-wfrp-panel
        .sheet-grid-span-2.sheet-flex
            span.wfrp-controls__cell(name = `attr_${hand}_hand_weapon_name`)
            input(name=`attr_${hand}_hand_weapon_is_pistol` type=`hidden`)
            input(name=`attr_${hand}_hand_weapon_is_ranged` value="1" type=`checkbox`, title="Switch pistol mode")
        span.sheet-grid-span-4(name=`attr_${hand}_hand_weapon_qualities_str`)

mixin hand-row(hand)
    -
        const grid_class = hand === 'main' ? 'sheet-grid-3' : 'sheet-grid-4'
    .sheet-hand-row-panel.sheet-grid-1
        input(type="hidden", name=`attr_${hand}_hand_weapon_id`)
        div(class=`${grid_class} sheet-grid-gap-5 sheet-wfrp-panel`)
            input(name=`attr_${hand}_hand_weapon_is_ranged`, type=`hidden`)
            input(name=`attr_${hand}_hand_weapon_is_pistol`, type=`hidden`)
            div.sheet-grid-1
                .sheet-wfrp-controls.sheet-grid-1.sheet-imaged
                    button(title="Opposed Attack", type="action", name=`act_${hand}_opposed_attack`)
            div.sheet-grid-1
                .sheet-wfrp-controls.sheet-grid-1.sheet-imaged
                    button(title="Unopposed Attack", type="action", name=`act_${hand}_unopposed_attack`)
            if hand === `off`
                div.sheet-grid-1
                    .sheet-wfrp-controls.sheet-grid-1.sheet-imaged
                        button(title="Second attack with Dual Wielder", type="action", name="act_dual_wielder_attack")
            input(name=`attr_active_defence`, type="hidden")
            .sheet-grid-1.sheet-grid-align-content-start.passive-defence
                span.wfrp-controls__cell(data-i18n="Use for defence")
                input.wfrp-settings__input(name=`attr_${hand}_hand_defence`, type="checkbox", value="1")
            input(name=`attr_active_defence`, type="hidden")
            div.sheet-grid-1.active-defence.sheet-imaged
                .sheet-wfrp-controls.sheet-grid-1.sheet-imaged
                    button(title="Defend with the weapon", type="action", name=`act_${hand}_defend`)

mixin encounter_button(label, type, value)
    div.sheet-grid-1
        .sheet-wfrp-controls.sheet-grid-1
            if type === "action"
                button(data-i18n=label, type="action", name=value)
            else
                button(data-i18n=label, type="roll", value=value)

mixin encounter-weapon-row
    .wfrp-weapontable__row.sheet-grid-9
        .wfrp-weapontable__cell.sheet-grid-span-2.sheet-grid-6.sheet-grid-gap-5
            .sheet-grid-span-1
                +display-toggle("show_description", false, "w")
            .sheet-grid-span-5
                span(name=`attr_weapon_name`)
        .wfrp-weapontable__cell.sheet-grid-span-2
            span(data-i18n="main-hand-checkbox")
            input.wfrp-settings__input(name=`attr_main_hand`, type="checkbox", value="1")
            span(data-i18n="off-hand-checkbox")
            input.wfrp-settings__input(name=`attr_off_hand`, type="checkbox", value="1")
        .wfrp-weapontable__cell.sheet-grid-span-1
            span(name=`attr_weapon_range`)
        .wfrp-weapontable__cell.sheet-grid-span-1
            span(name=`attr_weapon_damage`)
        .wfrp-weapontable__cell--last.sheet-grid-span-3.sheet-grid-2
            .sheet-grid-span-2
                span(name=`attr_weapon_qualities_str`)
    .wfrp-weapontable__row
        input(name="attr_show_description", type="hidden")
        textarea.wfrp-settings__textarea(name=`attr_weapon_description`)

mixin channelling-btn-group
    input(type="hidden" name="attr_spell_lore")
    each specialisation in skills.advanced[2].specialisations
        button(type="roll", name=specialisation, value=rolls[specialisation], data-i18n=specialisation)

mixin encounter-spell-row
    .wfrp-spelltable__row.sheet-grid-8
        input(type="hidden", name="attr_spell_total")
        input(type="hidden", name="attr_spell_name")
        input(type="hidden", name="attr_spell_target")
        input(type="hidden", name="attr_spell_duration_str")
        input(type="hidden", name="attr_spell_range_str")
        input(type="hidden", name="attr_spell_cn")
        input(type="hidden", name=`attr_spell_target_str`)
        input(type="hidden", name=`attr_spell_damage`)
        .wfrp-spelltable__cell.sheet-grid-span-2.sheet-grid-6.sheet-grid-gap-5
            .sheet-grid-span-1
                +display-toggle("show_description", false, "w")
            .sheet-grid-span-5
                button(type="roll", value=rolls.spell)
                    span(name=`attr_spell_name`)
        .wfrp-spelltable__cell.sheet-grid-span-1
            span(name=`attr_spell_range_str`)
        .wfrp-spelltable__cell.sheet-grid-span-1
            span(name=`attr_spell_target_str`)
        .wfrp-spelltable__cell.sheet-grid-span-1
            span(name=`attr_spell_duration_str`)
        .wfrp-spelltable__cell.sheet-grid-span-1
            span(name=`attr_spell_cn`)
        .wfrp-spelltable__cell--last.sheet-grid-span-2.sheet-wfrp-controls.sheet-grid-4.sheet-grid-gap-5
            input(name=`attr_spell_type`, type=`hidden`)
            .sheet-grid-span-2.sheet-encounter-channelling
                +channelling-btn-group()
            input(name=`attr_spell_type`, type=`hidden`)
            .sheet-grid-span-2.sheet-encounter-channelling.sheet-grid-align-items-center
                button.sheet-pictos(type="action", name="act_reset-channelling-sl") 1
                input(type="number", name="attr_channelling_sl")
                button.sheet-pictos(type="action", name="act_increment-channelling-sl") +
    .wfrp-weapontable__row
        input(name="attr_show_description", type="hidden")
        textarea.wfrp-settings__textarea(name=`attr_spell_description`)

mixin encounter-talent-row
    input(name=`attr_talent_settings`, type="hidden", value=1)
    input(name=`attr_is_combat`, type="hidden")
    .wfrp-talenttable__row
        .wfrp-talenttable__cell--settingstoggle
            +display-toggle(`talent_settings`, true)
        .wfrp-talenttable__cell
            +trait-toggle(`talent`, `attr_talent_name`)
        .wfrp-talenttable__cell
            span(name=`attr_talent_ranks`)
        .wfrp-talenttable__cell
            input.wfrp-settings__input(name=`attr_use_in_attack`, type="checkbox", value="1", title="Add the Talent's Ranks to SL of passed Weapon Test in Attack")
        input(name="attr_talent_toggle", type="hidden")
        .wfrp-talenttable__cell--description
            span(name=`attr_talent_description`)
        .wfrp-talenttable__row.wfrp-settings.control__hide--talent_settings
            +talent-row-settings()

mixin encounter-modifier(modifier)
    .sheet-flex.sheet-flex-justify-content-space-between
        div
            input.wfrp-settings__input(name=modifier.attr, type="checkbox", title=modifier.tooltip, value="1")
            span.wfrp-settings__label.sheet-margin-left-2.sheet-margin-right-2(title=modifier.tooltip, data-i18n=modifier.label)
            if modifier.type === `checkbox` && (modifier.group === `melee` || modifier.group === `ranged`)
                span.wfrp-settings__label (#{Object.values(modifier.mods)[0]})
        if modifier.type === `select`
            div
                select.wfrp-settings__input.sheet-text-align-center(name=modifier.option_attr)
                    for option in modifier.options
                        option(value=option.value, title=option.tooltip)
                            span(data-i18n=option.label)
                            if modifier.group === `melee` || modifier.group === `ranged`
                                span (#{option.mods[modifier.group]})

mixin encounter-modifier-list(group)
    div(style="width: 100%")
        for modifier in modifiers_v2.filter(m => (m.mods && Object.keys(m.mods).includes(group)) || (m.options && m.options.some(o => Object.keys(o.mods).includes(group))))
            +encounter-modifier-display(modifier, group)

mixin encounter-modifier-display(modifier, group)
    if modifier.type === "checkbox"
        input(name=modifier.attr, type="hidden")
        div.sheet-modifier-list
            span.wfrp-settings__label.sheet-margin-right-2(title=tooltip) (#{modifier.mods[group]})
            span.wfrp-settings__label.sheet-margin-right-2(title=modifier.tooltip, data-i18n=modifier.label)
    if modifier.type === "select"
        input(name=modifier.option_attr, type="hidden")
        input(name=modifier.attr, type="hidden")
        div
            for option in modifier.options
                div.sheet-modifier-list
                    if(option.mods[group])
                        span.wfrp-settings__label.sheet-margin-right-2(title=option.tooltip || modifier.tooltip) (#{option.mods[group]})
                        span.wfrp-settings__label.sheet-margin-right-2(title=option.tooltip || modifier.tooltip, data-i18n=option.label)
                        span.wfrp-settings__label(title=option.tooltip || modifier.tooltip, data-i18n=modifier.label)

mixin encounter-modifier-block(title, type)
    .sheet-wfrp-panel
        .sheet-bold.sheet-text-align-center(data-i18n=title)
        .sheet-grid-3.sheet-grid-justify-items-center
            label(title=title, class=`sheet-icon sheet-unopposed-${type}-attack-icon`)
                input(type="checkbox" value="1" name=`attr_show_modifiers_settings`, style="display: none;")
            div
                span(name=`attr_cm_${type}_sum`)
            button.sheet-pictos(type="action", name=`act_reset_${type}_modifiers`)
                div.sheet-text-align-center 1

mixin encounter()
    .wfrp-panel.page__encounter.sheet-grid-span-6
        .sheet-grid-8
            p.sheet-grid-span-1 Cell size
            input.sheet-grid-span-2(type="text", name="attr_cell_size")
        .sheet-grid-3
            .sheet-wfrp-panel
                +advantage()
            .sheet-wfrp-panel
                +wounds()
            .sheet-wfrp-panel
                +corruption_points()
                +fortune_points()
        .sheet-grid-2
            h1.wfrp-panel__header(data-i18n="Main hand")
            h1.wfrp-panel__header(data-i18n="Off hand")
        .sheet-grid-2.sheet-grid-gap-5
            +hand-header("main")
            +hand-header("off")
        .sheet-grid-2.sheet-grid-gap-5
            +hand-row("main")
            +hand-row("off")

        h1.wfrp-panel__header(data-i18n="Actions")
        .sheet-grid-2.sheet-grid-gap-5
            div.sheet-grid-3.sheet-grid-gap-5.sheet-wfrp-panel
                +encounter_button("Athletics", "roll", rolls.combat.athletics)
                +encounter_button("Cool", "roll", rolls.combat.cool)
                +encounter_button("Dodge", "roll", rolls.combat.dodge)
                +encounter_button("Drive", "roll", rolls.combat.drive)
                +encounter_button("Endurance", "roll", rolls.combat.endurance)
                +encounter_button("Intuition", "roll", rolls.combat.intuition)
                +encounter_button("Intimidate", "roll", rolls.combat.intimidate)
                +encounter_button("Leadership", "roll", rolls.combat.leadership)
                +encounter_button("Perception", "roll", rolls.combat.perception)
                .sheet-grid-span-3.sheet-wfrp-roll__divider
                +encounter_button("Initiative", "roll", "&{template:wfrp} {{name=@{character_name}}} {{roll_name=Initiative}} @{roll_init}")
                .sheet-grid-span-2.sheet-flex
                    span.wfrp-controls__cell(data-i18n=`Active Defence`)
                    input.wfrp-settings__input(name=`attr_active_defence`, type="checkbox", value="1")

            div.sheet-grid-3.sheet-grid-gap-5.sheet-wfrp-panel
                +encounter_button("Grapple", "action", "act_grapple")
                +encounter_button("Riposte", "action", "act_riposte")
                input(name=`attr_active_defence`, type="hidden")
                .sheet-grid-1.sheet-grid-align-content-start.passive-defence
                    span.wfrp-controls__cell(data-i18n=`Use Dodge for defence`)
                    input.wfrp-settings__input(name=`attr_dodge_defence`, type="checkbox", value="1")
                input(name=`attr_active_defence`, type="hidden")
                .active-defence
                    +encounter_button("Use Dodge for defence", "action", "act_dodge_defend")
                +encounter_button("Reroll Attacker Roll", "action", "act_reroll_as_attacker")
                +encounter_button("Reroll Defender Roll", "action", "act_reroll_as_defender")
                +encounter_button("Log Last Roll", "action", "act_debug_roll")

        h1.wfrp-panel__header(data-i18n="Modifiers")
        .sheet-grid-5
            +encounter-modifier-block("Melee Attack", `melee`)
            +encounter-modifier-block("Ranged Attack", `ranged`)
            +encounter-modifier-block("Parrying", `parry`)
            +encounter-modifier-block("Dodge", `dodge`)
            +encounter-modifier-block("Other", ``)
        input(type="hidden" name=`attr_show_modifiers_settings`)
        .sheet-wfrp-panel
            .sheet-grid-5.sheet-grid-justify-items-center.modifiers-settings.sheet-settings-color
                +encounter-modifier-list("melee")
                +encounter-modifier-list("ranged")
                +encounter-modifier-list("parry")
                +encounter-modifier-list("dodge")

            .sheet-wfrp-roll__divider
            .sheet-grid-3.modifiers-settings.sheet-grid-justify-items-center.sheet-settings-color
                div(style="width:90%")
                    h3(data-i18n="Melee Attack")
                    for modifier in modifiers_v2.filter(m => m.group === `melee`)
                        +encounter-modifier(modifier)
                div(style="width:90%")
                    h3(data-i18n="Ranged Attack")
                    for modifier in modifiers_v2.filter(m => m.group === `ranged`)
                        +encounter-modifier(modifier)
                div(style="width:90%")
                    h3(data-i18n="Other")
                    for modifier in modifiers_v2.filter(m => m.group === `other`)
                        +encounter-modifier(modifier)
                    .sheet-wfrp-roll__divider
                    .sheet-flex.sheet-flex-justify-content-space-between
                        div
                            input.wfrp-settings__input(name="attr_mounted", type="checkbox", title="You are mounted", value="1")
                            span.wfrp-settings__label.sheet-margin-left-2.sheet-margin-right-2(title="You are mounted", data-i18n="Mounted")
                        div
                            select.wfrp-settings__input.sheet-text-align-center(name="attr_mount_size_index")
                                option(data-i18n="Tiny", value="0")
                                option(data-i18n="Little", value="1")
                                option(data-i18n="Small", value="2")
                                option(data-i18n="Average", value="3")
                                option(data-i18n="Large", value="4" selected)
                                option(data-i18n="Enormous", value="5")
                                option(data-i18n="Monstrous", value="6")
                    .sheet-grid-2
                        div
                            input.wfrp-settings__input(name="attr_use_mount_for_charge", type="checkbox", title="Use Mount Size and Strength for Charge", value="1")
                            span.wfrp-settings__label.sheet-margin-left-2.sheet-margin-right-2(title="Use Mount Size and Strength for Charge", data-i18n="Use Mount for Charge")
                        div.sheet-grid-2
                            span(data-i18n="Strength")
                            div
                                input.wfrp-settings__input.sheet-text-align-center(name="attr_mount_strength", type="number" value="40")

        .sheet-grid-3.sheet-grid-gap-10
            .sheet-grid-span-2
                h1.wfrp-panel__header(data-i18n="Weapons")
                .sheet-wfrp-panel
                    .wfrp-weapontable__row--head.sheet-grid-9
                        .wfrp-weapontable__cell.sheet-grid-span-2(data-i18n="Name")
                        .wfrp-weapontable__cell.sheet-grid-span-2(data-i18n="Main/Off-hand")
                        .wfrp-weapontable__cell.sheet-grid-span-1(data-i18n="Range")
                        .wfrp-weapontable__cell.sheet-grid-span-1(data-i18n="Damage")
                        .wfrp-weapontable__cell--last.sheet-grid-span-3(data-i18n="Qualities")
                    +repeating-section("weapons","encounter-weapon-row")
                h1.wfrp-panel__header(data-i18n="Spells & Prayers")
                .sheet-wfrp-panel
                    .wfrp-spelltable__row--head.sheet-grid-8
                        .wfrp-spelltable__cell.sheet-grid-span-2(data-i18n="Name")
                        .wfrp-spelltable__cell.sheet-grid-span-1(data-i18n="Range")
                        .wfrp-spelltable__cell.sheet-grid-span-1(data-i18n="Target")
                        .wfrp-spelltable__cell.sheet-grid-span-1(data-i18n="Duration")
                        .wfrp-spelltable__cell.sheet-grid-span-1(data-i18n="CN")
                        .wfrp-spelltable__cell--last.sheet-grid-span-2(data-i18n="Channelling")
                    +repeating-section("spells","encounter-spell-row")
            .sheet-grid-span-1
                h1.wfrp-panel__header(data-i18n="Talents")
                .sheet-wfrp-panel
                    .wfrp-talenttable__row--head
                        .wfrp-talenttable__cell(data-i18n="Name")
                        .wfrp-talenttable__cell(data-i18n="Ranks")
                        .wfrp-talenttable__cell--last
                            button.sheet-pictos(type="action", name=`act_reset_talent_attack_sl`, title="Reset used talents in Attack")
                                div.sheet-text-align-center 1
                    +repeating-section("talent","encounter-talent-row")