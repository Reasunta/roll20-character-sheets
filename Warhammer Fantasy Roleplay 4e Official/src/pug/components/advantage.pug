mixin corruption_points()
    .sheet-grid-align-items-center.sheet-text-align-center.sheet-grid-6.sheet-size-large
        span(title="Corruption points counter", data-i18n="CP")
        button.wfrp-advantage__decrement.pictos(name="act_decrement_cp", type="action") -
        input.sheet-border.sheet-grid-span-2.sheet-size-large(name="attr_corruption_points", type="number", value="0")
        div.sheet-wfrp-field.no-border
            span.wfrp-armour__display.no-border /
            span.wfrp-armour__display.no-border(name="attr_corruption_points_max")
        button.wfrp-advantage__increment.pictos(name="act_increment_cp", type="action") +

mixin fortune_points()
    .sheet-grid-align-items-center.sheet-text-align-center.sheet-grid-6.sheet-size-large
        span(title="Fortune points counter", data-i18n="FP")
        button.wfrp-advantage__decrement.pictos(name="act_decrement_fp", type="action") -
        button.wfrp-advantage__reset.pictos(name="act_reset_fp", type="action") 1
        input.sheet-border.sheet-size-large(name="attr_fortune", type="number", value="0")
        div.sheet-wfrp-field.no-border
            span.wfrp-armour__display.no-border /
            span.wfrp-armour__display.no-border(name="attr_fortune_max")
        button.wfrp-advantage__increment.pictos(name="act_increment_fp", type="action") +
