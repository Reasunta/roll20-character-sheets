mixin row(label, value, condition, label_class = 'wfrp-roll__label', is_locale=true)
    if condition
        | {{##{condition}}}
    .wfrp-roll__row
        if is_locale
            div(class = label_class, data-i18n=label)
        else
            div(class = label_class) #{label}
        .wfrp-roll__value #{value}
    if condition
        | {{/#{condition}}}

mixin target(label, value, condition, value_class='wfrp-roll__value')
    if condition
        | {{##{condition}}}
    .wfrp-roll__target
        div.wfrp-roll__label(data-i18n=label)
        div(class = value_class) #{value}
    if condition
        | {{/#{condition}}}

mixin roll_row(label, value, crit_attr)
    +target(label, value, `rollTotal() ${crit_attr} 0`)
    +target(label, value, `rollTotal() ${crit_attr} -1`, value_class='wfrp-roll__value sheet-fullfail')
    +target(label, value, `rollTotal() ${crit_attr} 1`, value_class='wfrp-roll__value sheet-fullcrit')

mixin total_sl(class_name, label, value)
    div(class = class_name)
        span(data-i18n=label)
        span : #{value}

mixin damage
    +total_sl(`wfrp-roll__success`, `Total SL`, `{{computed::total_sl}}`)
    != `{{#rollGreater() aw_damage 0}}`
    +row(`Weapon damage`, `+{{aw_damage}}`)
    +row(`Damaging weapon`, `+{{computed::aw_damaging}}`, `rollGreater() computed::aw_damaging 0`, `wfrp-roll__label-italic`)
    +row(`Impact weapon`, `+{{computed::aw_impact}}`, `rollGreater() computed::aw_impact 0`, `wfrp-roll__label-italic`)
    +row(`Attacker is bigger`, `x{{computed::size_damage_mod}}`, `rollGreater() computed::size_damage_mod 1`, `wfrp-roll__label-italic`)
    .wfrp-roll__divider
    +row(`Hit Location`, `{{computed::hit_location}}`)
    +row(`AP`, `{{computed::armour}}`)
    +row(`Penetrating weapon`, `{{computed::aw_penetrating}} AP`, `rollLess() computed::aw_penetrating 0`, `wfrp-roll__label-italic`)
    +row(`Undamaging weapon`, `+{{computed::aw_undamaging}} AP`, `rollGreater() computed::aw_undamaging 0`, `wfrp-roll__label-italic`)
    +row(`TB`, `{{d_tb}}`)
    .wfrp-roll__divider
    +row(`Total damage`, `{{computed::total_damage}}`)
    != `{{/rollGreater() aw_damage 0}}`

mixin target-size
    +row(`Target is tiny`, `{{computed::d_size_mod}}`, `rollTotal() computed::d_size_mod -30`)
    +row(`Target is little`, `{{computed::d_size_mod}}`, `rollTotal() computed::d_size_mod -20`)
    +row(`Target is small`, `{{computed::d_size_mod}}`, `rollTotal() computed::d_size_mod -10`)
    +row(`Target is large`, `+{{computed::d_size_mod}}`, `rollTotal() computed::d_size_mod 20`)
    +row(`Target is enormous`, `{{computed::d_size_mod}}`, `rollTotal() computed::d_size_mod 40`)
    +row(`Target is monstrous`, `{{computed::d_size_mod}}`, `rollTotal() computed::d_size_mod 60`)



rolltemplate.sheet-rolltemplate-wfrp-opposed
    h3 {{name}}
    .wfrp-roll
        h1 {{a_name}} vs {{d_name}}
        != `{{#rollLess() computed::is_only_aw_name 1}}`
        h2 {{aw_name}} vs {{dw_name}}
        != `{{/rollLess() computed::is_only_aw_name 1}}`
        != `{{#rollGreater() computed::is_only_aw_name 0}}`
        h2 {{aw_name}}
        != `{{/rollGreater() computed::is_only_aw_name 0}}`
        .wfrp-roll__divider
        //- Attacker
        +roll_row(`Attacker roll`, `{{computed::a_roll}} vs {{computed::a_target}}`, `computed::a_is_crit`)
        +row(`Skill value`, `{{as_value}}`)
        +row(`Advantages`, `{{computed::a_adv}}`)
        for modifier in Object.values(modifiers).filter(m => Object.keys(m.values).includes('melee') || Object.keys(m.values).includes('ranged'))
            +row(modifier.label, `{{computed::a_${modifier.rt_attr}_value}}`, `^rollTotal() computed::a_${modifier.rt_attr} 0`)
        +row(`Off hand penalty`, `{{computed::a_off_hand_penalty}}`, `rollLess() computed::a_off_hand_penalty 0`)
        +row(`Main hand penalty`, `{{computed::a_main_hand_penalty}}`, `rollLess() computed::a_main_hand_penalty 0`)
        +row(`Accurate weapon`, `+{{computed::aw_accurate}}`, `rollGreater() computed::aw_accurate 0`, `wfrp-roll__label-italic`)
        +row(`Precise weapon`, `+{{computed::aw_precise}} SL`, `rollGreater() computed::aw_precise 0`, `wfrp-roll__label-italic`)
        +row(`Imprecise weapon`, `{{computed::aw_imprecise}} SL`, `rollLess() computed::aw_imprecise 0`, `wfrp-roll__label-italic`)
        +row(`Impale weapon`, ``, `rollGreater() computed::aw_impale 0`, `wfrp-roll__label-italic`)
        +row(`Dangerous weapon`, ``, `rollGreater() computed::aw_dangerous 0`, `wfrp-roll__label-italic`)
        +row(`Attacker is smaller`, `+{{computed::a_is_smaller_mod}}`, `rollGreater() computed::a_is_smaller_mod 0`)
        +target-size()
        +row(`{{a_talent_str}}`, `+{{a_talent_rank}} SL`, `rollGreater() computed::a_talent_rank 0`, `wfrp-roll__label-italic`, false)
        +row(`Attacker SL`, `{{computed::a_roll_sl}}`, ``, `wfrp-roll__label-underline`)

        != `{{#rollGreater() d_active_defence 0}}`
        +total_sl(`wfrp-roll__success`, `Need Defence action`, '')
        != `{{/rollGreater() d_active_defence 0}}`

        //- Defender
        != `{{#rollLess() d_active_defence 1}}`
        != `{{#rollGreater() computed::is_opposed 0}}`
        +roll_row(`Defender roll`, `{{computed::d_roll}} vs {{computed::d_target}}`, `computed::d_is_crit`)
        +row(`Skill value`, `{{ds_value}}`)
        +row(`Advantages`, `{{computed::d_adv}}`)
        for modifier in Object.values(modifiers).filter(m => Object.keys(m.values).includes('parry') || Object.keys(m.values).includes('dodge'))
            +row(modifier.label, `{{computed::d_${modifier.rt_attr}_value}}`, `^rollTotal() computed::d_${modifier.rt_attr} 0`)
        +row(`Off hand penalty`, `{{computed::d_off_hand_penalty}}`, `rollLess() computed::d_off_hand_penalty 0`)
        +row(`Main hand penalty`, `{{computed::d_main_hand_penalty}}`, `rollLess() computed::d_main_hand_penalty 0`)
        +row(`vs Fast weapon`, `{{computed::dw_fast}}`, `rollLess() computed::dw_fast 0`, `wfrp-roll__label-italic`)
        +row(`Defensive weapon`, `+{{computed::dw_defensive}} SL`, `rollGreater() computed::dw_defensive 0`, `wfrp-roll__label-italic`)
        +row(`vs Slow weapon`, `+{{computed::dw_defensive}} SL`, `rollGreater() computed::dw_slow 0`, `wfrp-roll__label-italic`)
        +row(`Impale weapon`, ``, `rollGreater() computed::dw_impale 0`, `wfrp-roll__label-italic`)
        +row(`Dangerous weapon`, ``, `rollGreater() computed::dw_dangerous 0`, `wfrp-roll__label-italic`)
        +row(`Defender is smaller`, `{{computed::d_is_smaller_sl}} SL`, `rollLess() computed::d_is_smaller_sl 0`, `wfrp-roll__label-italic`)
        +row(`{{d_talent_str}}`, `+{{d_talent_rank}} SL`, `rollGreater() computed::d_talent_rank 0`, `wfrp-roll__label-italic`, false)
        +row(`Defender SL`, `{{computed::d_roll_sl}}`, ``, `wfrp-roll__label-underline`)

        != `{{/rollGreater() computed::is_opposed 0}}`
        // Results
        != `{{#rollLess() computed::is_attacker_win 1}}`
        +total_sl(`wfrp-roll__fail`, `Total SL`, `{{computed::total_sl}}`)
        != `{{/rollLess() computed::is_attacker_win 1}}`
        != `{{#rollGreater() computed::is_attacker_win 0}}`
        +damage
        != `{{/rollGreater() computed::is_attacker_win 0}}`
        != `{{/rollLess() d_active_defence 1}}`

rolltemplate.sheet-rolltemplate-wfrp-riposte
    h3 {{name}}
    .wfrp-roll
        h1 {{a_name}} vs {{d_name}}
        h2 {{aw_name}}
        .wfrp-roll__divider
        +damage

rolltemplate.sheet-rolltemplate-wfrp-initial
    .wfrp-roll
        h1 {{character_name}}
        h2 Initial char values
        .wfrp-roll__divider
        +row(`Weapon Skill`, `{{weapon_skill}}`)
        +row(`Ballistic Skill`, `{{ballistic_skill}}`)
        +row(`Strength`, `{{strength}}`)
        +row(`Toughness`, `{{toughness}}`)
        +row(`Initiative`, `{{initiative}}`)
        +row(`Agility`, `{{agility}}`)
        +row(`Dexterity`, `{{dexterity}}`)
        +row(`Intelligence`, `{{intelligence}}`)
        +row(`Willpower`, `{{willpower}}`)
        +row(`Fellowship`, `{{fellowship}}`)
